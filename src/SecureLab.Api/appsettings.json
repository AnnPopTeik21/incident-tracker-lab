{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "LoginThrottle": {
      "PermitLimit": 4,
      "WindowSeconds": 30
    }
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "AllowReset": false
  }
}
